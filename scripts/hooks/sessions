#!/usr/bin/env -S uv run --script --offline
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Return ordered Codex and Pi sessions for the Trees workspace session hook."""

import json
import os
from pathlib import Path
import re
import sqlite3
import sys
import tomllib
from contextlib import closing
from datetime import datetime, timezone


class ProviderError(Exception):
    """Metadata is unavailable or the hook request is invalid."""


def canonical(path):
    value = Path(path)
    if not value.is_absolute():
        raise ProviderError("workspace and session paths must be absolute")
    return value.resolve()


def resolve_path(value, base):
    path = Path(value).expanduser()
    if not path.is_absolute():
        path = base / path
    return path.resolve()


def parse_timestamp(value):
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.endswith(("Z", "z")):
        text = text[:-1] + "+00:00"
    try:
        parsed = datetime.fromisoformat(text)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def parse_entry(line):
    try:
        entry = json.loads(line)
    except ValueError:
        return None
    return entry if isinstance(entry, dict) else None


def codex_storage_paths():
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").resolve()
    config_path = home / "config.toml"
    config = tomllib.loads(config_path.read_text()) if config_path.exists() else {}
    configured = config.get("sqlite_home")
    if configured is not None:
        if not isinstance(configured, str) or not configured.strip():
            raise ProviderError("sqlite_home must be a nonempty path")
        database_home = Path(configured)
        if not database_home.is_absolute():
            database_home = home / database_home
    else:
        database_home = Path(os.environ.get("CODEX_SQLITE_HOME", "").strip() or home)
    return home, database_home.resolve()


def state_database(directory):
    candidates = []
    if not directory.exists():
        return None
    for path in directory.iterdir():
        match = re.fullmatch(r"state_(\d+)\.sqlite", path.name)
        if match:
            candidates.append((int(match[1]), path))
    return max(candidates, key=lambda candidate: candidate[0])[1] if candidates else None


def main_session(source):
    if not isinstance(source, str):
        return False
    if source.lower().startswith("subagent"):
        return False
    if source.startswith("{"):
        try:
            return "subagent" not in json.loads(source)
        except (ValueError, TypeError):
            return False
    return True


def indexed_names(home, ids):
    names = {}
    path = home / "session_index.jsonl"
    if not ids or not path.exists():
        return names
    with path.open(encoding="utf-8") as stream:
        for line in stream:
            try:
                entry = json.loads(line)
            except ValueError:
                # Codex's append-only index can end with an incomplete write.
                continue
            if not isinstance(entry, dict):
                continue
            identifier, name = entry.get("id"), entry.get("thread_name")
            if isinstance(identifier, str) and identifier in ids and isinstance(name, str) and name.strip():
                names[identifier] = name.strip()
    return names


def codex_timestamp(row):
    milliseconds = row["updated_at_ms"]
    value = milliseconds if milliseconds is not None else row["updated_at"]
    if not isinstance(value, int):
        raise ProviderError("invalid Codex session timestamp")
    # Older databases can retain millisecond values in the legacy timestamp column.
    seconds = value / 1000 if milliseconds is not None or abs(value) >= 100_000_000_000 else value
    return datetime.fromtimestamp(seconds, timezone.utc)


def codex_sessions(roots):
    home, database_home = codex_storage_paths()
    database = state_database(database_home)
    if database is None:
        return []
    sessions = []
    with closing(sqlite3.connect(database.as_uri() + "?mode=ro", uri=True, timeout=0.25)) as connection:
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA query_only = ON")
        connection.execute("BEGIN")
        columns = {row[1] for row in connection.execute("PRAGMA table_info(threads)")}
        required = {"id", "cwd", "source", "archived", "updated_at"}
        if not required <= columns:
            raise ProviderError("unsupported Codex threads schema")
        fields = ["id", "cwd", "source", "updated_at"]
        for field in ("updated_at_ms", "name", "title", "preview", "first_user_message"):
            fields.append(field if field in columns else f"NULL AS {field}")
        rows = []
        for row in connection.execute(f"SELECT {', '.join(fields)} FROM threads WHERE archived = 0"):
            if not main_session(row["source"]):
                continue
            if not isinstance(row["cwd"], str) or not Path(row["cwd"]).is_absolute():
                continue
            root = canonical(row["cwd"])
            if root in roots:
                if not isinstance(row["id"], str) or not row["id"].strip():
                    raise ProviderError("invalid Codex session ID")
                rows.append((codex_timestamp(row), row["id"], root, row))
    names = indexed_names(home, {identifier for _, identifier, _, _ in rows})
    for updated, identifier, root, row in rows:
        candidates = (row["name"], names.get(identifier), row["title"], row["preview"], row["first_user_message"])
        title = next((value.strip() for value in candidates if isinstance(value, str) and value.strip()), "Untitled session")
        sessions.append(
            {
                "agent": "codex",
                "id": identifier,
                "title": title,
                "updated": updated,
                "root": root,
            }
        )
    return sessions


def pi_storage_root():
    agent_value = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
    if agent_value:
        agent_dir = resolve_path(agent_value, Path.cwd())
    else:
        agent_dir = (Path.home() / ".pi" / "agent").resolve()
    configured = os.environ.get("PI_CODING_AGENT_SESSION_DIR", "").strip()
    if configured:
        return resolve_path(configured, Path.cwd())
    settings_path = agent_dir / "settings.json"
    if settings_path.exists():
        try:
            settings = json.loads(settings_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, ValueError) as error:
            raise ProviderError(f"cannot read Pi settings: {error}") from error
        if not isinstance(settings, dict):
            raise ProviderError("Pi settings must be an object")
        session_dir = settings.get("sessionDir")
        if session_dir is not None:
            if not isinstance(session_dir, str) or not session_dir.strip():
                raise ProviderError("sessionDir must be a nonempty path")
            return resolve_path(session_dir, Path.cwd())
    return agent_dir / "sessions"


def pi_session_files(directory):
    if not directory.is_dir():
        return []
    files = []
    for current, _, names in os.walk(directory, onerror=lambda _: None):
        for name in names:
            if name.endswith(".jsonl"):
                files.append(Path(current) / name)
    return sorted(files)


def message_activity(entry):
    message = entry.get("message")
    if not isinstance(message, dict) or "content" not in message:
        return None
    if message.get("role") not in ("user", "assistant"):
        return None
    value = message.get("timestamp")
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        try:
            return datetime.fromtimestamp(value / 1000, timezone.utc)
        except (OverflowError, OSError, ValueError):
            return None
    return parse_timestamp(entry.get("timestamp"))


def message_text(message):
    content = message.get("content")
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts = []
    for block in content:
        if isinstance(block, dict) and block.get("type") == "text" and isinstance(block.get("text"), str):
            parts.append(block["text"])
    return " ".join(parts)


def pi_session(path, roots):
    try:
        with path.open(encoding="utf-8", errors="replace") as stream:
            header = None
            for line in stream:
                entry = parse_entry(line)
                if entry is None:
                    continue
                if entry.get("type") != "session":
                    return None
                header = entry
                break
            if header is None:
                return None
            cwd = header.get("cwd")
            if not isinstance(cwd, str) or not cwd:
                return None
            try:
                root = canonical(cwd)
            except ProviderError:
                return None
            if root not in roots:
                return None
            identifier = header.get("id")
            if not isinstance(identifier, str) or not identifier.strip():
                return None
            name = None
            first_user = ""
            activity = None
            for line in stream:
                entry = parse_entry(line)
                if entry is None:
                    continue
                entry_type = entry.get("type")
                if entry_type == "session_info":
                    value = entry.get("name")
                    if isinstance(value, str):
                        name = value.strip() or None
                    else:
                        name = None
                    continue
                if entry_type != "message":
                    continue
                message = entry.get("message")
                if not isinstance(message, dict) or "content" not in message:
                    continue
                timestamp = message_activity(entry)
                if timestamp is not None and (activity is None or timestamp > activity):
                    activity = timestamp
                if message.get("role") == "user" and not first_user:
                    text = message_text(message)
                    if text.strip():
                        first_user = text
            updated = activity or parse_timestamp(header.get("timestamp"))
            if updated is None:
                try:
                    updated = datetime.fromtimestamp(path.stat().st_mtime, timezone.utc)
                except OSError:
                    return None
            title = name or first_user.strip() or "Untitled session"
            return {
                "agent": "pi",
                "id": identifier,
                "title": title,
                "updated": updated,
                "root": root,
            }
    except OSError:
        return None


def pi_sessions(roots):
    directory = pi_storage_root()
    sessions = []
    for path in pi_session_files(directory):
        session = pi_session(path, roots)
        if session is not None:
            sessions.append(session)
    return sessions


def lookup(request):
    if not isinstance(request, dict) or type(request.get("version")) is not int or request["version"] != 1:
        raise ProviderError("expected hook protocol version 1")
    workspaces = request.get("workspaces")
    if not isinstance(workspaces, list):
        raise ProviderError("workspaces must be an array")
    roots = {}
    result = {}
    for workspace in workspaces:
        if not isinstance(workspace, dict) or not isinstance(workspace.get("id"), str) or not workspace["id"]:
            raise ProviderError("workspace ID must be a nonempty string")
        if not isinstance(workspace.get("path"), str):
            raise ProviderError("workspace path must be a string")
        identifier = workspace["id"]
        if identifier in result:
            raise ProviderError("duplicate workspace ID")
        roots.setdefault(canonical(workspace["path"]), []).append(identifier)
        result[identifier] = {"sessions": []}
    response = {"version": 1, "workspaces": result}
    if not roots:
        return response
    sessions = codex_sessions(roots) + pi_sessions(roots)
    sessions.sort(key=lambda session: (session["updated"], session["id"], session["agent"]), reverse=True)
    for session in sessions:
        updated = session["updated"].isoformat().replace("+00:00", "Z")
        for workspace_id in roots[session["root"]]:
            result[workspace_id]["sessions"].append(
                {
                    "agent": session["agent"],
                    "id": session["id"],
                    "title": session["title"],
                    "updated_at": updated,
                }
            )
    return response


def main():
    try:
        request = json.load(sys.stdin)
        response = lookup(request)
        print(json.dumps(response, ensure_ascii=False, separators=(",", ":")))
        return 0
    except (OSError, ValueError, TypeError, OverflowError, sqlite3.Error, ProviderError) as error:
        print(f"Agent session hook: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
